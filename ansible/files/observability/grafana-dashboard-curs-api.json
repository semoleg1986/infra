{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "targets": [
        {
          "expr": "sum by(service) (rate(http_requests_total{service=~\"users_service|course_service|payments_service\"}[5m]))",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ],
      "title": "Requests Rate (RPS)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "targets": [
        {
          "expr": "sum by(service) (rate(http_request_duration_seconds_sum{service=~\"users_service|course_service|payments_service\"}[5m])) / clamp_min(sum by(service) (rate(http_request_duration_seconds_count{service=~\"users_service|course_service|payments_service\"}[5m])), 1)",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ],
      "title": "Average Latency (5m)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "id": 3,
      "targets": [
        {
          "expr": "sum by(service) (rate(http_errors_total{service=~\"users_service|course_service|payments_service\",status=~\"5..\"}[5m])) / clamp_min(sum by(service) (rate(http_requests_total{service=~\"users_service|course_service|payments_service\"}[5m])), 1)",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ],
      "title": "5xx Ratio",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "id": 4,
      "targets": [
        {
          "expr": "sum by(service,status) (rate(http_requests_total{service=~\"users_service|course_service|payments_service\"}[5m]))",
          "legendFormat": "{{service}} / {{status}}",
          "refId": "A"
        }
      ],
      "title": "Responses by Status",
      "type": "timeseries"
    }
  ],
  "schemaVersion": 39,
  "style": "dark",
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "title": "Curs API Health (users/course/payments)",
  "uid": "curs-api-health",
  "version": 1
}
