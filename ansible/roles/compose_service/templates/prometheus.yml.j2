global:
  scrape_interval: 15s
  evaluation_interval: 15s

rule_files:
  - /etc/prometheus/prometheus-alerts.yml

scrape_configs:
  - job_name: auth_service
    static_configs:
      - targets: ["curs_auth_service:8000"]
    metrics_path: /metrics
{% if observability_metrics_token | default('') | trim %}
    authorization:
      type: Bearer
      credentials: "{{ observability_metrics_token }}"
{% endif %}

  - job_name: users_service
    static_configs:
      - targets: ["curs_users_service:8002"]
    metrics_path: /metrics
{% if observability_metrics_token | default('') | trim %}
    authorization:
      type: Bearer
      credentials: "{{ observability_metrics_token }}"
{% endif %}

  - job_name: course_service
    static_configs:
      - targets: ["curs_course_service:8001"]
    metrics_path: /metrics
{% if observability_metrics_token | default('') | trim %}
    authorization:
      type: Bearer
      credentials: "{{ observability_metrics_token }}"
{% endif %}

  - job_name: payments_service
    static_configs:
      - targets: ["curs_payments_service:8004"]
    metrics_path: /metrics
{% if observability_metrics_token | default('') | trim %}
    authorization:
      type: Bearer
      credentials: "{{ observability_metrics_token }}"
{% endif %}

{% if services.live_class_service.enabled | default(false) %}
  - job_name: live_class_service
    static_configs:
      - targets: ["curs_live_class_service:8010"]
    metrics_path: /metrics
{% if observability_metrics_token | default('') | trim %}
    authorization:
      type: Bearer
      credentials: "{{ observability_metrics_token }}"
{% endif %}
{% endif %}
